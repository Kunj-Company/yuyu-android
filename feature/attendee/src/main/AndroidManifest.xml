<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local event reminders (requested with a rationale the first time one would be scheduled). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Saving certificates to Pictures/Yuyu on Android 8–9 (MediaStore needs no permission from 10). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <!-- Shares downloaded certificate images from the app cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attendee.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attendee_file_paths" />
        </provider>
    </application>

    <queries>
        <!-- Add to calendar. -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>
</manifest>
